      "resources/ollama_models/blobs/sha256-b1b0036de383cfacd2f6f0ec14c43139d08a215e673fadaf4f3601eac4bd5490": "resources/ollama_models/blobs/sha256-b1b0036de383cfacd2f6f0ec14c43139d08a215e673fadaf4f3601eac4bd5490",
      "resources/ollama_models/blobs/sha256-ebabfa59b71a5b96e0281ec2994977e785284e0939807a99fc340dec3c6f10de": "resources/ollama_models/blobs/sha256-ebabfa59b71a5b96e0281ec2994977e785284e0939807a99fc340dec3c6f10de",
