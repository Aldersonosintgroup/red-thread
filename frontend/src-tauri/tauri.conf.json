{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "The Red Thread",
  "version": "0.1.0",
  "identifier": "llc.aldersonosint.redthread",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "The Red Thread",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": false,
        "center": true
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "title": "The Red Thread",
        "width": 480,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/redthread-backend",
      "binaries/ollama"
    ],
    "resources": {
      "resources/lib/ollama/**/*": "lib/ollama/",
      "resources/ollama_models/manifests/registry.ollama.ai/library/qwen3-vl/2b": "resources/ollama_models/manifests/registry.ollama.ai/library/qwen3-vl/2b",
